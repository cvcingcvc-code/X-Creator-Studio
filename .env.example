# 数据库路径配置（默认在 ./data/x-creator.db，云端部署请挂载持久化卷，禁止依赖临时目录）
DATABASE_PATH=./data/x-creator.db

# 文本大模型配置（支持 OpenAI / DeepSeek / SiliconFlow / Gemini OpenAI 兼容接口）
# 未配置时系统不会伪造模型调用，仅输出基于真实搜索源的结构化草稿骨架
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 生图模型配置（独立于文本模型；支持 DALL-E 3 / Flux 等 OpenAI 兼容生图接口）
# 未配置时允许创作者手动上传本地图片，绝不使用假图片冒充真实生图
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3

# 真实联网搜索 API 配置（可选，不配置时仍可使用内置 GitHub API、Hacker News 与官方 RSS 源）
GITHUB_TOKEN=
TAVILY_API_KEY=
SERPER_API_KEY=

# xAI X Search 与 X (Twitter) 官方 API 预留配置（仅保存在服务端，严禁上传公开仓库）
XAI_API_KEY=
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
